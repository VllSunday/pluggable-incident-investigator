INVESTIGATOR_MODE=demo
INVESTIGATOR_DATA_DIR=data
INVESTIGATOR_GITHUB_WEBHOOK_SECRET=replace-with-at-least-8-characters
INVESTIGATOR_GITLAB_WEBHOOK_TOKEN=replace-with-at-least-8-characters
INVESTIGATOR_ALERTMANAGER_WEBHOOK_TOKEN=replace-with-at-least-8-characters
INVESTIGATOR_ADMIN_API_TOKEN=replace-with-at-least-16-random-characters
INVESTIGATOR_WORKER_POLL_SECONDS=0.5
# Dashboard talks to the protected control-plane API. Override only outside Compose.
# INVESTIGATOR_API_URL=http://127.0.0.1:8000
# Optional connected-mode evidence access (use least-privilege read tokens)
# INVESTIGATOR_GITHUB_API_TOKEN=
# INVESTIGATOR_GITHUB_API_URL=https://api.github.com
# INVESTIGATOR_GITLAB_API_TOKEN=
# INVESTIGATOR_GITLAB_API_URL=https://gitlab.com/api/v4
# INVESTIGATOR_PROMETHEUS_URL=http://prometheus:9090
# Server-owned allowlisted PromQL templates. `{service}` is safely JSON-quoted.
# INVESTIGATOR_PROMETHEUS_QUERY_TEMPLATES={"target_health":"up{{job={service}}}"}
# Connected mode enables real structured LLM reasoning
# INVESTIGATOR_MODE=connected
# INVESTIGATOR_OPENAI_API_KEY=
# INVESTIGATOR_OPENAI_MODEL=gpt-5.4-mini
# INVESTIGATOR_TELEGRAM_BOT_TOKEN=
# INVESTIGATOR_TELEGRAM_CHAT_ID=
# Safe remediation is opt-in and requires connected mode, an SCM token, Docker,
# and server-owned allowlisted commands. The JSON value is parsed by Pydantic.
# INVESTIGATOR_REMEDIATION_ENABLED=true
# INVESTIGATOR_REMEDIATION_SANDBOX_IMAGE=python:3.12-slim
# INVESTIGATOR_REMEDIATION_CHECK_PROFILES={"python":[["python","-m","pytest","-q"],["python","-m","ruff","check","."]]}
# LangSmith tracing is enabled by its standard environment variables:
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=incident-investigator
